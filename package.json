{
  "name": "gherkin-node-test",
  "version": "0.4.0",
  "description": "The smallest honest Gherkin runner and feature-file linter \u2014 zero dependencies, native on node:test, bun:test, and Deno, built for agent-driven BDD.",
  "license": "MIT",
  "author": "Bing Ho <reps-attic-riot@duck.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingh0/gherkin-node-test.git"
  },
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=18.3"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "types": "tsc index.js --declaration --emitDeclarationOnly --allowJs --noCheck --outDir . --target es2022 --module nodenext --skipLibCheck --types node"
  },
  "keywords": [
    "gherkin",
    "gherkin-lint",
    "linter",
    "bdd",
    "cucumber",
    "node-test",
    "bun",
    "bun-test",
    "deno",
    "deno-test",
    "zero-dependency",
    "acceptance-testing",
    "agent",
    "vibe-coding"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
