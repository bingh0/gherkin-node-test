{
  "name": "gherkin-node-test",
  "version": "0.10.0",
  "description": "The smallest honest Gherkin runner and feature-file linter — zero dependencies, native on node:test, bun:test, and Deno, with a vitest adapter, built for agent-driven BDD.",
  "license": "MIT",
  "author": "Bing Ho <reps-attic-riot@duck.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingh0/gherkin-node-test.git"
  },
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.mjs"
    },
    "./index.js": "./index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.17"
  },
  "peerDependencies": {
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "vitest.mjs",
    "vitest.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:vitest": "vitest run",
    "typecheck": "tsc -p fixtures/typecheck",
    "typecheck:ts5": "npx -y -p typescript@5 tsc -p fixtures/typecheck"
  },
  "keywords": [
    "gherkin",
    "gherkin-lint",
    "linter",
    "bdd",
    "cucumber",
    "node-test",
    "bun",
    "bun-test",
    "deno",
    "deno-test",
    "zero-dependency",
    "acceptance-testing",
    "agent",
    "vibe-coding"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/bingh0/gherkin-node-test#readme",
  "bugs": {
    "url": "https://github.com/bingh0/gherkin-node-test/issues"
  },
  "funding": "https://github.com/sponsors/bingh0"
}
